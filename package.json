{
  "name": "@ray-d3v/convomux",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Teams and Slack CLI. One command: cmx.",
  "type": "module",
  "bin": {
    "cmx": "dist/cli.js"
  },
  "files": [
    "LICENSE",
    "dist",
    "vendor",
    "patches/slk",
    "backend-contracts.json",
    "THIRD_PARTY_NOTICES.md",
    "docs/RELEASING.md",
    "docs/INSTALL_CANDIDATE.md",
    "docs/DEPENDENCY_NOTICES.md",
    "docs/CREDENTIAL_STORAGE.md",
    "docs/PATCHED_BACKENDS.md",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm test",
    "test:focused": "npm run build && node --test",
    "backends:prepare": "node scripts/backend-artifacts.mjs",
    "backends:notices": "node scripts/collect-slk-notices.mjs",
    "backends:verify": "node scripts/verify-vendor.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "prepack": "node scripts/check-pack-host.mjs && npm run build && npm run backends:verify"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ray-d3v/convomux.git"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "@types/semver": "7.7.1",
    "fflate": "0.8.3",
    "tar": "7.5.22",
    "typescript": "5.8.3"
  },
  "license": "MIT",
  "bundleDependencies": ["msteams", "semver"],
  "dependencies": {
    "msteams": "0.2.1",
    "semver": "7.7.3"
  }
}
